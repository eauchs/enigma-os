{
  "name": "enigma-shell",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "tsd --typings main.d.ts --files tests/types/**/*.tsd && vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" playwright.config.ts eslint.config.js",
    "e2e": "playwright test",
    "dev:renderer": "vite dev --config renderer.vite.config.ts --host 127.0.0.1 --port 4173 --strictPort",
    "preview:renderer": "vite preview --config renderer.vite.config.ts --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.913.0",
    "@google/genai": "^1.0.0",
    "idb-keyval": "^6.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-istanbul": "^2.1.8",
    "electron": "^38.3.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^4.0.1",
    "eslint": "^9.15.0",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-testing-library": "^6.4.2",
    "eslint-plugin-vitest": "^0.5.4",
    "fake-indexeddb": "^6.0.1",
    "jsdom": "^25.0.1",
    "msw": "^2.7.0",
    "tsd": "^0.31.0",
    "typescript": "5.5.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.11",
    "vitest": "^2.1.8"
  }
}
